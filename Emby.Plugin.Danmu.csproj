<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Description>弹幕插件</Description>
        <AssemblyVersion>2.0.3.0</AssemblyVersion>
        <FileVersion>2.0.3.3</FileVersion>
        <InformationalVersion>2.0.3r3</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <PackageTags>emby;plugin;pms;media;server;</PackageTags>
        <LangVersion>8.0</LangVersion>
        <DanmuConfigCacheToken>$([System.Text.RegularExpressions.Regex]::Replace('$(InformationalVersion)', '[^A-Za-z0-9_-]+', '-'))</DanmuConfigCacheToken>
        <DanmuConfigCacheToken>$([System.Text.RegularExpressions.Regex]::Replace('$(DanmuConfigCacheToken)', '(^-+|-+$)', ''))</DanmuConfigCacheToken>
        <DanmuConfigCacheToken Condition="'$(DanmuConfigCacheToken)' == ''">build</DanmuConfigCacheToken>
        <GeneratedDanmuConfigurationDirectory>$(MSBuildProjectDirectory)\obj\Generated\Configuration</GeneratedDanmuConfigurationDirectory>
        <GeneratedDanmuConfigurationPage>$(GeneratedDanmuConfigurationDirectory)\configPage.html</GeneratedDanmuConfigurationPage>
        <GeneratedDanmuConfigurationConstants>$(GeneratedDanmuConfigurationDirectory)\GeneratedConfigurationPageResources.cs</GeneratedDanmuConfigurationConstants>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="Configuration\logo.png" />
        <Compile Remove="RegressionTests\**\*.cs" />
        <Compile Remove="Generated\**\*.cs" />
        <!-- <None Remove="Scraper\Bilibili\**" /> -->
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Configuration\logo.png" />
        <!-- <EmbeddedResource Remove="Scraper\Bilibili\**" /> -->
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="ComposableAsync.Core" Version="1.3.0" />
        <PackageReference Include="Costura.Fody" Version="6.0.0">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Fody" Version="6.9.2">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Google.Protobuf" Version="3.31.0" />
        <PackageReference Include="MediaBrowser.Server.Core" Version="4.8.5" />
        <!--        <PackageReference Include="System.Memory" Version="4.5.1" />-->
        <!--              <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.2.5" />-->
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="2.2.0" />
        <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="2.2.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="2.2.0" />
        <PackageReference Include="SharpZipLib.NETStandard" Version="1.0.7" />
        <PackageReference Include="System.Net.Http.Json" Version="8.0.0" />
        <!--        <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>-->
        <!--      <PackageReference Include="System.Text.Json" Version="8.0.3" />-->
    </ItemGroup>

<!--    <Target Name="PostBuild" AfterTargets="PostBuildEvent">-->
<!--        <Exec Command="cp $(TargetPath) $(HOME)/.config/emby-server/plugins/"/>-->
<!--        <Exec Command="cp $(TargetPath) ../doc/"/>-->
<!--        <Exec Command="killall EmbyServer" ContinueOnError="true"/>-->
<!--        <Exec Command="sleep 3"/>-->
<!--        <Exec Command="open -a EmbyServer"/>-->
<!--    </Target>-->

    <ItemGroup>
        <None Remove="Configuration/configPage.html" />
        <None Remove="Configuration/config.js" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="$(GeneratedDanmuConfigurationPage)" LogicalName="$(RootNamespace).Configuration.configPage.html" />
        <EmbeddedResource Include="Configuration/config.js" />
        <Compile Include="$(GeneratedDanmuConfigurationConstants)" />
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Doc\image\" />
    </ItemGroup>

    <Target Name="GenerateDanmuConfigurationPageResources" BeforeTargets="PrepareResources;CoreCompile">
        <MakeDir Directories="$(GeneratedDanmuConfigurationDirectory)" />
        <ReadLinesFromFile File="Configuration\configPage.html">
            <Output TaskParameter="Lines" ItemName="DanmuConfigurationTemplateLine" />
        </ReadLinesFromFile>
        <WriteLinesToFile
            File="$(GeneratedDanmuConfigurationPage)"
            Lines="@(DanmuConfigurationTemplateLine->Replace('__DANMU_CONFIG_CACHE_TOKEN__', '$(DanmuConfigCacheToken)'))"
            Overwrite="true" />
        <WriteLinesToFile
            File="$(GeneratedDanmuConfigurationConstants)"
            Lines="namespace Emby.Plugin.Danmu.Configuration { internal static class GeneratedConfigurationPageResources { internal const string CacheToken = &quot;$(DanmuConfigCacheToken)&quot;%3B internal const string PageName = &quot;danmu-$(DanmuConfigCacheToken)&quot;%3B internal const string ControllerName = &quot;danmuJs-$(DanmuConfigCacheToken)&quot;%3B } }"
            Overwrite="true" />
    </Target>
</Project>
